{
  "$schema": "http://json.schemastore.org/template",
  "author": "Tristan Rhodes",
  "classifications": [ "DotNet Core", "Solution" ],
  "identity": "Pragsys.TemplateApi",
  "name": "Tested Api Template",
  "description": "Postgres database with API, comes with DbUp, packages as Api and containers.",
  "shortName": "Pragsys.TemplateApi",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "ProjectName": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true
    },
    "RenameNamespaces": {
      "type": "derived",
      "valueSource": "ProjectName",
      "valueTransform": "chain",
      "replaces": "Pragsys.TemplateApi"
    },
    "RenameFiles": {
      "type": "derived",
      "valueSource": "ProjectName",
      "valueTransform": "chain",
      "fileRename": "Pragsys.TemplateApi"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [ "**/.vs/**", ".template_config/**", ".git/**", ".NCrunch_*/**", "*.ncrunch", "template.cake" ]
        }
      ]
    }
  ]
}